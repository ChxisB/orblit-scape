# Copy to /etc/scape/server.env. Every line is optional. A value that does
# not parse stops the server at startup, and the log says which one.

# Players connect here. Put a reverse proxy in front to end TLS.
SCAPE_PORT=7600
SCAPE_ADDRESS=127.0.0.1

# Saves go in $SCAPE_DATA/$SCAPE_WORLD. The unit file lets the server write
# only to /var/lib/scape.
SCAPE_DATA=/var/lib/scape
SCAPE_WORLD=scape

# Answers "alive" to any connection. 0 turns it off.
SCAPE_HEALTH_PORT=7601

# warn logs what went wrong. info adds a health line each minute.
SCAPE_LOG_LEVEL=info

# Who may run commands, for example ana=admin,bo=moderator. Needs accounts.
SCAPE_ADMINS=
